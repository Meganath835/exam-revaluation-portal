<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Revaluation" targetNamespace="http://example.com/revaluation" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_Revaluation">
    <bpmn:participant id="Participant_Revaluation" name="Examination Revaluation Request" processRef="revaluationProcess" />
  </bpmn:collaboration>
  <bpmn:process id="revaluationProcess" name="Examination Revaluation Request" isExecutable="true">
    <bpmn:documentation>Main process. Started by the Spring Boot backend (POST /api/requests) with the start payload described in the README. The clerk assigns two independent examiners per subject (parallel multi-instance per subject); both examiners then evaluate at the same time (parallel multi-instance per subject and examiner).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Revaluation">
      <bpmn:lane id="Lane_RequestEligibility" name="Request and Eligibility">
        <bpmn:flowNodeRef>requestStarted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitRevaluationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verifyApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluateEligibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eligibleGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PaymentProcessing" name="Payment Processing">
        <bpmn:flowNodeRef>createRazorpayOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completeCheckoutAndVerifyPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paymentWindowExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paymentGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyPaymentFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closedPaymentFailed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ExaminationRevaluation" name="Examination and Revaluation">
        <bpmn:flowNodeRef>clerkAssignExaminer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examinerSendsMarks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluateMarksDifference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>marksIncreasedGateway</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ModerationApproval" name="Moderation and Approval">
        <bpmn:flowNodeRef>coeApproveResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>increaseApprovedGateway</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ResultPublication" name="Result Publication">
        <bpmn:flowNodeRef>updateOfficialResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyResultPublished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- ===================== Request and Eligibility ===================== -->

    <bpmn:startEvent id="requestStarted" name="Request started">
      <bpmn:outgoing>flowToSubmit</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="submitRevaluationRequest" name="Submit revaluation request">
      <bpmn:documentation>The student's request form. The backend completes this task right after the student submits the form in the portal (declarationAccepted = true once the backend has validated the subjects and marks). If that does not happen, the task stays in the student's task inbox.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="submit-request" />
        <zeebe:assignmentDefinition assignee="=studentId" />
      </bpmn:extensionElements>
      <bpmn:incoming>flowToSubmit</bpmn:incoming>
      <bpmn:outgoing>flowToVerify</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="verifyApplication" name="Exam cell verifies application">
      <bpmn:documentation>The exam cell checks the student's application (subjects, marks against the marks card, documents) and accepts or rejects it: applicationComplete, verificationRemarks. A rejection is explained to the student through the eligibility decision.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="verify-application" />
        <zeebe:assignmentDefinition candidateGroups="exam-cell" />
      </bpmn:extensionElements>
      <bpmn:incoming>flowToVerify</bpmn:incoming>
      <bpmn:outgoing>flowToEligibility</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:businessRuleTask id="evaluateEligibility" name="Evaluate Eligibility">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="eligibilityDecision" resultVariable="eligibility" />
        <zeebe:ioMapping>
          <zeebe:input source="=today() &lt;= date(resultPublishedOn) + duration(config.revaluationWindow)" target="withinWindow" />
          <zeebe:input source="=applicationComplete = true" target="applicationComplete" />
          <zeebe:output source="=eligibility" target="eligibility" />
          <zeebe:output source="=if eligibility.eligible = false and applicationComplete = false and verificationRemarks != null and verificationRemarks != &#34;&#34; then eligibility.reason + &#34; Remarks: &#34; + verificationRemarks else eligibility.reason" target="rejectionReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>flowToEligibility</bpmn:incoming>
      <bpmn:outgoing>flowToEligibleGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="eligibleGateway" name="Eligible?" default="flowNotEligible">
      <bpmn:incoming>flowToEligibleGateway</bpmn:incoming>
      <bpmn:outgoing>flowEligible</bpmn:outgoing>
      <bpmn:outgoing>flowNotEligible</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="notifyRejected" name="Notify: request rejected" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="2">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:email:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="simple" target="authentication.type" />
          <zeebe:input source="{{secrets.SMTP_USERNAME}}" target="authentication.username" />
          <zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" />
          <zeebe:input source="smtp" target="protocol" />
          <zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" />
          <zeebe:input source="{{secrets.SMTP_PORT}}" target="data.smtpConfig.smtpPort" />
          <zeebe:input source="{{secrets.SMTP_SECURITY}}" target="data.smtpConfig.smtpCryptographicProtocol" />
          <zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" />
          <zeebe:input source="{{secrets.SMTP_FROM}}" target="data.smtpAction.from" />
          <zeebe:input source="=studentEmail" target="data.smtpAction.to" />
          <zeebe:input source="=&#34;Revaluation request &#34; + requestId + &#34; was not accepted&#34;" target="data.smtpAction.subject" />
          <zeebe:input source="PLAIN" target="data.smtpAction.contentType" />
          <zeebe:input source="=&#34;Dear &#34; + studentName + &#34;,\n\nYour revaluation request &#34; + requestId + &#34; was not accepted.\nReason: &#34; + rejectionReason + &#34;\n\nOffice of the Controller of Examinations&#34;" target="data.smtpAction.body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>flowNotEligible</bpmn:incoming>
      <bpmn:outgoing>flowToRejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="requestRejected" name="Closed">
      <bpmn:incoming>flowToRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ===================== Payment Processing ===================== -->

    <bpmn:serviceTask id="createRazorpayOrder" name="Create Razorpay test order - REST Connector">
      <bpmn:documentation>REST Outbound Connector. Credentials come from connector secrets RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET; nothing secret is stored in this file.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="basic" target="authentication.type" />
          <zeebe:input source="{{secrets.RAZORPAY_KEY_ID}}" target="authentication.username" />
          <zeebe:input source="{{secrets.RAZORPAY_KEY_SECRET}}" target="authentication.password" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=config.razorpayBaseUrl + &#34;/v1/orders&#34;" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={amount: count(subjects) * feePerSubject, currency: &#34;INR&#34;, receipt: requestId, notes: {studentId: studentId, examSession: examSession}}" target="body" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={&#10;  razorpayOrderId: response.body.id,&#10;  razorpayAmount: response.body.amount,&#10;  razorpayCurrency: response.body.currency,&#10;  razorpayOrderStatus: response.body.status&#10;}" />
          <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>flowEligible</bpmn:incoming>
      <bpmn:outgoing>flowToCheckout</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="completeCheckoutAndVerifyPayment" name="Complete Checkout and Verify Payment">
      <bpmn:documentation>The student pays in Razorpay Checkout. The backend (POST /api/payments/{requestId}/confirm) verifies HMAC-SHA256(order_id|payment_id) with the key secret and completes this task with paymentSuccessful.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="=studentId" />
      </bpmn:extensionElements>
      <bpmn:incoming>flowToCheckout</bpmn:incoming>
      <bpmn:outgoing>flowToPaymentGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="paymentWindowExpired" name="Payment window expired" attachedToRef="completeCheckoutAndVerifyPayment">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=true" target="paymentExpired" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>flowExpiredToNotify</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=config.paymentWindow</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:exclusiveGateway id="paymentGateway" name="Payment successful?" default="flowPaymentFailed">
      <bpmn:incoming>flowToPaymentGateway</bpmn:incoming>
      <bpmn:outgoing>flowPaymentSuccessful</bpmn:outgoing>
      <bpmn:outgoing>flowPaymentFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="notifyPaymentFailed" name="Notify Payment Failure" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="2">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:email:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="simple" target="authentication.type" />
          <zeebe:input source="{{secrets.SMTP_USERNAME}}" target="authentication.username" />
          <zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" />
          <zeebe:input source="smtp" target="protocol" />
          <zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" />
          <zeebe:input source="{{secrets.SMTP_PORT}}" target="data.smtpConfig.smtpPort" />
          <zeebe:input source="{{secrets.SMTP_SECURITY}}" target="data.smtpConfig.smtpCryptographicProtocol" />
          <zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" />
          <zeebe:input source="{{secrets.SMTP_FROM}}" target="data.smtpAction.from" />
          <zeebe:input source="=studentEmail" target="data.smtpAction.to" />
          <zeebe:input source="=if paymentExpired = true then &#34;Revaluation request &#34; + requestId + &#34; closed: fee not paid&#34; else &#34;Payment for revaluation request &#34; + requestId + &#34; failed&#34;" target="data.smtpAction.subject" />
          <zeebe:input source="PLAIN" target="data.smtpAction.contentType" />
          <zeebe:input source="=&#34;Dear &#34; + studentName + &#34;,\n\n&#34; + (if paymentExpired = true then &#34;The payment window for request &#34; + requestId + &#34; ended before the fee was paid, so the request was closed. You can submit a new request while the revaluation window is open.&#34; else &#34;We could not verify the payment for request &#34; + requestId + &#34;, so the request was closed. If money left your account it will be returned automatically.&#34;) + &#34;\n\nOffice of the Controller of Examinations&#34;" target="data.smtpAction.body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>flowPaymentFailed</bpmn:incoming>
      <bpmn:incoming>flowExpiredToNotify</bpmn:incoming>
      <bpmn:outgoing>flowToClosedPaymentFailed</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="closedPaymentFailed" name="Closed">
      <bpmn:incoming>flowToClosedPaymentFailed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ===================== Examination and Revaluation (one instance per subject) ===================== -->

    <bpmn:userTask id="clerkAssignExaminer" name="Clerk assigns independent examiners">
      <bpmn:documentation>Exam cell picks two different examiners from the subject's department, neither of whom did the first evaluation, and confirms the answer script id.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="assign-examiner" />
        <zeebe:assignmentDefinition candidateGroups="exam-cell" />
        <zeebe:ioMapping>
          <zeebe:input source="=null" target="firstExaminerId" />
          <zeebe:input source="=null" target="secondExaminerId" />
          <zeebe:input source="=null" target="scriptId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>flowPaymentSuccessful</bpmn:incoming>
      <bpmn:outgoing>flowToExaminerMarks</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=subjects" inputElement="subject" outputCollection="assignments" outputElement="=context put(context put(context put(subject, &#34;firstExaminerId&#34;, firstExaminerId), &#34;secondExaminerId&#34;, secondExaminerId), &#34;scriptId&#34;, scriptId)" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>

    <bpmn:userTask id="examinerSendsMarks" name="Examiner sends updated marks to clerk">
      <bpmn:documentation>Blind re-evaluation. One instance per subject and examiner, all in parallel: both independent examiners of a subject evaluate the script at the same time. An examiner does not see the student's identity, the original marks or the other examiner.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="examiner-marks" />
        <zeebe:assignmentDefinition assignee="=subject.examinerId" />
        <zeebe:taskSchedule dueDate="=now() + duration(config.examinerSla)" />
        <zeebe:ioMapping>
          <zeebe:input source="=null" target="examinerMarks" />
          <zeebe:input source="=null" target="examinerRemarks" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>flowToExaminerMarks</bpmn:incoming>
      <bpmn:outgoing>flowToCompare</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=for s in assignments, n in [1, 2] return context put(context put(s, &#34;examinerNo&#34;, n), &#34;examinerId&#34;, if n = 1 then s.firstExaminerId else s.secondExaminerId)" inputElement="subject" outputCollection="evaluations" outputElement="={subjectCode: subject.subjectCode, examinerNo: subject.examinerNo, examinerId: subject.examinerId, marks: examinerMarks, remarks: examinerRemarks}" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>

    <bpmn:businessRuleTask id="evaluateMarksDifference" name="Evaluate Marks Difference">
      <bpmn:documentation>Once per subject. Revised marks are the average of both examiners' marks, rounded half up; the decision table compares them with the original marks.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="marksComparisonDecision" resultVariable="marksIncreased" />
        <zeebe:ioMapping>
          <zeebe:input source="=subject.originalMarks" target="originalMarks" />
          <zeebe:input source="=evaluations[item.subjectCode = subject.subjectCode and item.examinerNo = 1][1].marks" target="firstExaminerMarks" />
          <zeebe:input source="=evaluations[item.subjectCode = subject.subjectCode and item.examinerNo = 2][1].marks" target="secondExaminerMarks" />
          <zeebe:input source="=floor((sum(evaluations[item.subjectCode = subject.subjectCode].marks) + 1) / 2)" target="revisedMarks" />
          <zeebe:input source="=null" target="marksIncreased" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>flowToCompare</bpmn:incoming>
      <bpmn:outgoing>flowToMarksGateway</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=assignments" inputElement="subject" outputCollection="subjectResults" outputElement="={subjectCode: subject.subjectCode, subjectName: subject.subjectName, department: subject.department, maxMarks: subject.maxMarks, scriptId: subject.scriptId, originalMarks: originalMarks, proposedMarks: revisedMarks, firstExaminerId: subject.firstExaminerId, firstExaminerMarks: firstExaminerMarks, secondExaminerId: subject.secondExaminerId, secondExaminerMarks: secondExaminerMarks, revisedMarks: revisedMarks, markDifference: revisedMarks - originalMarks, marksIncreased: marksIncreased = true, outcome: if marksIncreased = true then &#34;REVISED&#34; else &#34;UNCHANGED&#34;}" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="marksIncreasedGateway" name="Marks increased?" default="flowMarksNotIncreased">
      <bpmn:incoming>flowToMarksGateway</bpmn:incoming>
      <bpmn:outgoing>flowMarksIncreased</bpmn:outgoing>
      <bpmn:outgoing>flowMarksNotIncreased</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ===================== Moderation and Approval ===================== -->

    <bpmn:userTask id="coeApproveResult" name="CoE approves revised result">
      <bpmn:documentation>The Controller of Examinations approves or rejects the increase of every subject whose marks went up; the decision is final. The backend writes the decision into subjectResults: a rejected increase becomes WITHHELD and keeps the original marks.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="coe-approval" />
        <zeebe:assignmentDefinition candidateGroups="coe" />
        <zeebe:taskSchedule dueDate="=now() + duration(config.examinerSla)" />
      </bpmn:extensionElements>
      <bpmn:incoming>flowMarksIncreased</bpmn:incoming>
      <bpmn:outgoing>flowToIncreaseApprovedGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="increaseApprovedGateway" name="Increase approved?" default="flowIncreaseNotApproved">
      <bpmn:incoming>flowToIncreaseApprovedGateway</bpmn:incoming>
      <bpmn:outgoing>flowIncreaseApproved</bpmn:outgoing>
      <bpmn:outgoing>flowIncreaseNotApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="updateOfficialResult" name="Update official result">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="update-result" />
        <zeebe:assignmentDefinition candidateGroups="exam-cell" />
      </bpmn:extensionElements>
      <bpmn:incoming>flowIncreaseApproved</bpmn:incoming>
      <bpmn:outgoing>flowUpdatedToPublish</bpmn:outgoing>
    </bpmn:userTask>

    <!-- ===================== Result Publication ===================== -->

    <bpmn:serviceTask id="notifyResultPublished" name="Notify: Revaluation Result Published" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="2">
      <bpmn:documentation>Start execution listener consolidate-results saves the final per-subject results to the database before the email is sent.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:executionListeners>
          <zeebe:executionListener eventType="start" retries="3" type="consolidate-results" />
        </zeebe:executionListeners>
        <zeebe:taskDefinition type="io.camunda:email:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="simple" target="authentication.type" />
          <zeebe:input source="{{secrets.SMTP_USERNAME}}" target="authentication.username" />
          <zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" />
          <zeebe:input source="smtp" target="protocol" />
          <zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" />
          <zeebe:input source="{{secrets.SMTP_PORT}}" target="data.smtpConfig.smtpPort" />
          <zeebe:input source="{{secrets.SMTP_SECURITY}}" target="data.smtpConfig.smtpCryptographicProtocol" />
          <zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" />
          <zeebe:input source="{{secrets.SMTP_FROM}}" target="data.smtpAction.from" />
          <zeebe:input source="=studentEmail" target="data.smtpAction.to" />
          <zeebe:input source="=&#34;Revaluation result for &#34; + requestId" target="data.smtpAction.subject" />
          <zeebe:input source="PLAIN" target="data.smtpAction.contentType" />
          <zeebe:input source="=&#34;Dear &#34; + studentName + &#34;,\n\nThe revaluation of request &#34; + requestId + &#34; is complete.\n\n&#34; + string join(for r in subjectResults return r.subjectCode + &#34;: &#34; + string(r.originalMarks) + &#34; -&gt; &#34; + string(r.revisedMarks) + (if r.marksIncreased then &#34; (increased)&#34; else if r.outcome = &#34;WITHHELD&#34; then &#34; (increase not approved)&#34; else &#34; (unchanged)&#34;), &#34;\n&#34;) + &#34;\n\nOffice of the Controller of Examinations&#34;" target="data.smtpAction.body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>flowUpdatedToPublish</bpmn:incoming>
      <bpmn:incoming>flowMarksNotIncreased</bpmn:incoming>
      <bpmn:incoming>flowIncreaseNotApproved</bpmn:incoming>
      <bpmn:outgoing>flowToCompleted</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="requestCompleted" name="Completed">
      <bpmn:incoming>flowToCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ===================== Sequence flows ===================== -->

    <bpmn:sequenceFlow id="flowToSubmit" sourceRef="requestStarted" targetRef="submitRevaluationRequest" />
    <bpmn:sequenceFlow id="flowToVerify" sourceRef="submitRevaluationRequest" targetRef="verifyApplication" />
    <bpmn:sequenceFlow id="flowToEligibility" sourceRef="verifyApplication" targetRef="evaluateEligibility" />
    <bpmn:sequenceFlow id="flowToEligibleGateway" sourceRef="evaluateEligibility" targetRef="eligibleGateway" />
    <bpmn:sequenceFlow id="flowEligible" name="Yes" sourceRef="eligibleGateway" targetRef="createRazorpayOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligibility.eligible = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowNotEligible" name="No" sourceRef="eligibleGateway" targetRef="notifyRejected" />
    <bpmn:sequenceFlow id="flowToRejected" sourceRef="notifyRejected" targetRef="requestRejected" />
    <bpmn:sequenceFlow id="flowToCheckout" sourceRef="createRazorpayOrder" targetRef="completeCheckoutAndVerifyPayment" />
    <bpmn:sequenceFlow id="flowToPaymentGateway" sourceRef="completeCheckoutAndVerifyPayment" targetRef="paymentGateway" />
    <bpmn:sequenceFlow id="flowPaymentSuccessful" name="Yes" sourceRef="paymentGateway" targetRef="clerkAssignExaminer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentSuccessful = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowPaymentFailed" name="No" sourceRef="paymentGateway" targetRef="notifyPaymentFailed" />
    <bpmn:sequenceFlow id="flowExpiredToNotify" sourceRef="paymentWindowExpired" targetRef="notifyPaymentFailed" />
    <bpmn:sequenceFlow id="flowToClosedPaymentFailed" sourceRef="notifyPaymentFailed" targetRef="closedPaymentFailed" />
    <bpmn:sequenceFlow id="flowToExaminerMarks" sourceRef="clerkAssignExaminer" targetRef="examinerSendsMarks" />
    <bpmn:sequenceFlow id="flowToCompare" sourceRef="examinerSendsMarks" targetRef="evaluateMarksDifference" />
    <bpmn:sequenceFlow id="flowToMarksGateway" sourceRef="evaluateMarksDifference" targetRef="marksIncreasedGateway" />
    <bpmn:sequenceFlow id="flowMarksIncreased" name="Yes" sourceRef="marksIncreasedGateway" targetRef="coeApproveResult">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=some r in subjectResults satisfies r.marksIncreased = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowToIncreaseApprovedGateway" sourceRef="coeApproveResult" targetRef="increaseApprovedGateway" />
    <bpmn:sequenceFlow id="flowIncreaseApproved" name="Yes" sourceRef="increaseApprovedGateway" targetRef="updateOfficialResult">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=some r in subjectResults satisfies r.marksIncreased = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowIncreaseNotApproved" name="No" sourceRef="increaseApprovedGateway" targetRef="notifyResultPublished" />
    <bpmn:sequenceFlow id="flowMarksNotIncreased" name="No" sourceRef="marksIncreasedGateway" targetRef="notifyResultPublished" />
    <bpmn:sequenceFlow id="flowUpdatedToPublish" sourceRef="updateOfficialResult" targetRef="notifyResultPublished" />
    <bpmn:sequenceFlow id="flowToCompleted" sourceRef="notifyResultPublished" targetRef="requestCompleted" />
  </bpmn:process>
