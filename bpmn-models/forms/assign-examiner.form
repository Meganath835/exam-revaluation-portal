{
  "executionPlatform": "Camunda Cloud", "executionPlatformVersion": "8.9.0", "exporter": {"name": "Camunda Modeler", "version": "5.46.1"}, "schemaVersion": 18, "type": "default", "id": "assign-examiner",
  "components": [
    { "type": "text", "id": "Text_Header", "text": "=\"### Assign two independent examiners\n\" + subject.subjectCode + \" \" + subject.subjectName + \" (\" + subject.department + \")\"" },
    { "type": "textfield", "id": "Field_FirstExaminerId", "key": "firstExaminerId", "label": "First examiner username", "description": "Same department, not the first evaluator", "validate": { "required": true } },
    { "type": "textfield", "id": "Field_SecondExaminerId", "key": "secondExaminerId", "label": "Second examiner username", "description": "Same department, not the first evaluator, different from the first examiner", "validate": { "required": true } },
    { "type": "textfield", "id": "Field_ScriptId", "key": "scriptId", "label": "Answer script ID", "validate": { "required": true } }
  ]
}
