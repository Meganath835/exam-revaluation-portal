# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# ---- Database ----
DB_USER=revaluation
DB_PASSWORD=change-me

# ---- Camunda connection ----
# Local Camunda (docker compose --profile camunda): keep these defaults.
CAMUNDA_MODE=self-managed
CAMUNDA_AUTH_METHOD=none
# Camunda 8 SaaS: set CAMUNDA_MODE=saas, CAMUNDA_AUTH_METHOD=oidc and fill in the API client values
# from Console > your cluster > API > Create client.
CAMUNDA_CLUSTER_ID=
CAMUNDA_REGION=
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=
# Login for Operate/Tasklist on the local Camunda
CAMUNDA_UI_USER=demo
CAMUNDA_UI_PASSWORD=demo

# ---- Razorpay (test mode) ----
# Mock mode works offline: the backend imitates Razorpay and the UI offers a test checkout.
RAZORPAY_MOCK=true
RAZORPAY_CONNECTOR_BASE_URL=http://backend:8080/mock/razorpay
RAZORPAY_KEY_ID=rzp_test_mock
RAZORPAY_KEY_SECRET=mock_secret_change_me
# Real Razorpay test mode: RAZORPAY_MOCK=false, RAZORPAY_CONNECTOR_BASE_URL=https://api.razorpay.com
# and your own keys from Dashboard > Account & Settings > API Keys (Test mode).

# ---- Email (local profile uses Mailpit; for real email use Mailtrap or a Gmail app password) ----
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=NONE
SMTP_USERNAME=demo
SMTP_PASSWORD=demo
SMTP_FROM=revaluation@example.edu

# ---- Workflow timings (ISO-8601). Short values make the timers visible in a demo. ----
FEE_PER_SUBJECT_PAISE=50000
REVALUATION_WINDOW=P15D
PAYMENT_WINDOW=PT5M
# Due date shown on the two examiner tasks
EXAMINER_SLA=PT10M
